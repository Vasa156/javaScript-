let arr = [2, 5, 8, 7, 10];

let evenCount = 0;
let oddCount = 0;

// write your loop here
for(let i=0;i<arr.length;i++){
    if(arr[i] % 2 === 0){
        evenCount++;
    }
    else{
        oddCount++;
    }
}
console.log("Even:", evenCount);
console.log("Odd:", oddCount);

//output Even: 3
//Odd: 2
